# Copy to .env (git-ignored) and replace the placeholder values. Local development only.
POSTGRES_DB=movie_booking
POSTGRES_USER=movie_booking
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional host ports (bound to 127.0.0.1 only). The backend is not published; it is reached
# through the frontend's same-origin proxy at http://localhost:${FRONTEND_HOST_PORT}/api.
POSTGRES_HOST_PORT=5432
FRONTEND_HOST_PORT=3000
